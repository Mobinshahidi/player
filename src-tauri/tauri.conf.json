{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "player",
  "version": "0.1.0",
  "identifier": "com.player.gui",
  "build": {
    "beforeDevCommand": "npm run gui:server",
    "devUrl": "http://127.0.0.1:45871",
    "frontendDist": "../src/gui"
  },
  "app": {
    "windows": [
      {
        "title": "player",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
